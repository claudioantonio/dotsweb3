# Copy to .env.devnet (local `cartesi run`) or .env.opsepolia and fill in.
# Run with: npm run dev -w @dotsweb3/frontend -- --mode devnet
# Never put private keys here — everything prefixed VITE_ is shipped to the browser.

# L1 chain: 31337 (devnet / Anvil) or 11155420 (OP Sepolia)
VITE_CHAIN_ID=31337
VITE_L1_RPC_URL=http://localhost:8545

# From `cartesi address-book` (devnet) or the deploy record (OP Sepolia)
VITE_APP_ADDRESS=0x0000000000000000000000000000000000000000
VITE_INPUT_BOX_ADDRESS=0x0000000000000000000000000000000000000000

# Cartesi node. Port is printed by `cartesi run`.
VITE_NODE_RPC_URL=http://localhost:6751/rpc
VITE_INSPECT_URL=http://localhost:6751/inspect/dotsweb3

# Optional one-line status banner shown on every page (the only support surface).
# VITE_STATUS_BANNER=Session #1 Thursday 19:00 UTC — follow @handle for updates

# Optional, dev server only (not shipped): if the node sends no CORS headers,
# set NODE_PROXY_TARGET=http://localhost:6751 and use relative URLs above
# (VITE_NODE_RPC_URL=/rpc, VITE_INSPECT_URL=/inspect/dotsweb3).
# NODE_PROXY_TARGET=
